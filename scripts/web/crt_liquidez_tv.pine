//@version=6
indicator("CRT Dashboard V6 - Auto SL/TP", overlay=true, max_lines_count = 500, max_labels_count = 500)

// --- CONFIGURACIÓN ---
tp_sweep_pct = input.float(0.50, "Nivel Sweep 1 (50%)")
tp_run_ext   = input.float(1.618, "Obj. RUN (161.8%)")
merge_ticks  = input.int(10, "Tolerancia unir líneas (Ticks)")

// --- BASE DE DATOS DE WIN RATES V5 ---
get_stats(ticker, tf, pattern) =>
    float wr = 0.0
    is_eur = str.contains(ticker, "EURUSD")
    is_gbp = str.contains(ticker, "GBPUSD")
    is_jpy = str.contains(ticker, "USDJPY")
    is_gold = str.contains(ticker, "XAUUSD") or str.contains(ticker, "GOLD")
    is_nas = str.contains(ticker, "USTEC") or str.contains(ticker, "NAS100") or str.contains(ticker, "NDQ100") or str.contains(ticker, "NQ")

    if is_eur
        if tf == "MN1"
            wr := pattern == "B.SWP" ? 58.8 : pattern == "S.SWP" ? 62.5 : pattern == "B.RUN" ? 47.1 : pattern == "S.RUN" ? 43.8 : 0
        else if tf == "W1"
            wr := pattern == "B.SWP" ? 60.8 : pattern == "S.SWP" ? 60.3 : pattern == "B.RUN" ? 62.5 : pattern == "S.RUN" ? 57.0 : 0
        else if tf == "D1"
            wr := pattern == "B.SWP" ? 59.0 : pattern == "S.SWP" ? 60.2 : pattern == "B.RUN" ? 59.1 : pattern == "S.RUN" ? 59.1 : 0
        else if tf == "H12"
            wr := pattern == "B.SWP" ? 59.8 : pattern == "S.SWP" ? 62.5 : pattern == "B.RUN" ? 57.0 : pattern == "S.RUN" ? 57.4 : 0
        else if tf == "H8"
            wr := pattern == "B.SWP" ? 58.3 : pattern == "S.SWP" ? 60.0 : pattern == "B.RUN" ? 51.6 : pattern == "S.RUN" ? 50.6 : 0
        else if tf == "H4"
            wr := pattern == "B.SWP" ? 57.7 : pattern == "S.SWP" ? 56.8 : pattern == "B.RUN" ? 50.6 : pattern == "S.RUN" ? 49.6 : 0

    if is_gbp
        if tf == "MN1"
            wr := pattern == "B.SWP" ? 61.1 : pattern == "S.SWP" ? 61.5 : pattern == "B.RUN" ? 38.9 : pattern == "S.RUN" ? 46.2 : 0
        else if tf == "W1"
            wr := pattern == "B.SWP" ? 59.3 : pattern == "S.SWP" ? 59.8 : pattern == "B.RUN" ? 55.5 : pattern == "S.RUN" ? 59.7 : 0
        else if tf == "D1"
            wr := pattern == "B.SWP" ? 57.3 : pattern == "S.SWP" ? 55.7 : pattern == "B.RUN" ? 58.2 : pattern == "S.RUN" ? 57.7 : 0
        else if tf == "H12"
            wr := pattern == "B.SWP" ? 61.5 : pattern == "S.SWP" ? 58.8 : pattern == "B.RUN" ? 56.8 : pattern == "S.RUN" ? 56.2 : 0
        else if tf == "H8"
            wr := pattern == "B.SWP" ? 56.7 : pattern == "S.SWP" ? 60.4 : pattern == "B.RUN" ? 54.6 : pattern == "S.RUN" ? 51.6 : 0
        else if tf == "H4"
            wr := pattern == "B.SWP" ? 61.0 : pattern == "S.SWP" ? 54.2 : pattern == "B.RUN" ? 52.1 : pattern == "S.RUN" ? 50.6 : 0

    if is_jpy
        if tf == "MN1"
            wr := pattern == "B.SWP" ? 60.0 : pattern == "S.SWP" ? 61.5 : pattern == "B.RUN" ? 45.0 : pattern == "S.RUN" ? 46.2 : 0
        else if tf == "W1"
            wr := pattern == "B.SWP" ? 61.4 : pattern == "S.SWP" ? 58.9 : pattern == "B.RUN" ? 56.8 : pattern == "S.RUN" ? 56.7 : 0
        else if tf == "D1"
            wr := pattern == "B.SWP" ? 57.7 : pattern == "S.SWP" ? 58.1 : pattern == "B.RUN" ? 57.0 : pattern == "S.RUN" ? 57.9 : 0
        else if tf == "H12"
            wr := pattern == "B.SWP" ? 61.6 : pattern == "S.SWP" ? 57.0 : pattern == "B.RUN" ? 57.3 : pattern == "S.RUN" ? 57.5 : 0
        else if tf == "H8"
            wr := pattern == "B.SWP" ? 62.2 : pattern == "S.SWP" ? 55.3 : pattern == "B.RUN" ? 57.6 : pattern == "S.RUN" ? 59.4 : 0
        else if tf == "H4"
            wr := pattern == "B.SWP" ? 61.4 : pattern == "S.SWP" ? 54.7 : pattern == "B.RUN" ? 53.4 : pattern == "S.RUN" ? 56.8 : 0

    if is_gold
        if tf == "MN1"
            wr := pattern == "B.SWP" ? 53.3 : pattern == "S.SWP" ? 58.8 : pattern == "B.RUN" ? 46.7 : pattern == "S.RUN" ? 41.2 : 0
        else if tf == "W1"
            wr := pattern == "B.SWP" ? 66.1 : pattern == "S.SWP" ? 57.8 : pattern == "B.RUN" ? 61.6 : pattern == "S.RUN" ? 55.0 : 0
        else if tf == "D1"
            wr := pattern == "B.SWP" ? 63.3 : pattern == "S.SWP" ? 59.7 : pattern == "B.RUN" ? 60.9 : pattern == "S.RUN" ? 56.7 : 0
        else if tf == "H12"
            wr := pattern == "B.SWP" ? 63.5 : pattern == "S.SWP" ? 60.3 : pattern == "B.RUN" ? 58.2 : pattern == "S.RUN" ? 53.2 : 0
        else if tf == "H8"
            wr := pattern == "B.SWP" ? 63.6 : pattern == "S.SWP" ? 55.6 : pattern == "B.RUN" ? 57.5 : pattern == "S.RUN" ? 55.3 : 0
        else if tf == "H4"
            wr := pattern == "B.SWP" ? 59.5 : pattern == "S.SWP" ? 55.1 : pattern == "B.RUN" ? 55.4 : pattern == "S.RUN" ? 52.4 : 0

    if is_nas
        if tf == "MN1"
            wr := pattern == "B.SWP" ? 66.7 : pattern == "S.SWP" ? 53.3 : pattern == "B.RUN" ? 46.7 : pattern == "S.RUN" ? 40.0 : 0
        else if tf == "W1"
            wr := pattern == "B.SWP" ? 68.8 : pattern == "S.SWP" ? 50.0 : pattern == "B.RUN" ? 58.8 : pattern == "S.RUN" ? 54.8 : 0
        else if tf == "D1"
            wr := pattern == "B.SWP" ? 63.1 : pattern == "S.SWP" ? 55.1 : pattern == "B.RUN" ? 59.4 : pattern == "S.RUN" ? 49.1 : 0
        else if tf == "H12"
            wr := pattern == "B.SWP" ? 70.8 : pattern == "S.SWP" ? 63.7 : pattern == "B.RUN" ? 51.2 : pattern == "S.RUN" ? 47.6 : 0
        else if tf == "H8"
            wr := pattern == "B.SWP" ? 61.2 : pattern == "S.SWP" ? 56.1 : pattern == "B.RUN" ? 49.3 : pattern == "S.RUN" ? 45.8 : 0
        else if tf == "H4"
            wr := pattern == "B.SWP" ? 57.1 : pattern == "S.SWP" ? 51.2 : pattern == "B.RUN" ? 48.5 : pattern == "S.RUN" ? 48.6 : 0
    wr

get_dir(bias_str) =>
    if str.contains(bias_str, "B.SWP") or str.contains(bias_str, "B.RUN")
        "BULL"
    else if str.contains(bias_str, "S.SWP") or str.contains(bias_str, "S.RUN")
        "BEAR"
    else
        "NEUTRO"

// --- LÓGICA DE NIVELES E INVALIDACIÓN ---
get_crt_info(tf) =>
    [h2, l2, h1, l1, c1, h0, l0, c0] = request.security(syminfo.tickerid, tf, [high[2], low[2], high[1], low[1], close[1], high, low, close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    
    string c_bias = "-"
    string pot = "-"
    color c_col = color.gray
    color p_col = color.gray
    float t1 = na
    float t2 = na
    string label_t1 = ""
    string label_t2 = ""

    // Nombre legible del timeframe para las etiquetas
    string tf_name = tf
    if tf == "720"
        tf_name := "H12"
    else if tf == "480"
        tf_name := "H8"
    else if tf == "240"
        tf_name := "H4"
    else if tf == "1M"
        tf_name := "MN1"
    else if tf == "1W"
        tf_name := "W1"
    else if tf == "1D"
        tf_name := "D1"

    range_prev = h2 - l2
    mid = l2 + (range_prev * tp_sweep_pct)
    ext_bull = l2 + (range_prev * tp_run_ext)
    ext_bear = h2 - (range_prev * tp_run_ext)

    // 1. BIAS CONFIRMADO (Con validación de Stop Loss y Take Profit)
    if l1 < l2 and c1 > l2 and h1 < h2
        // BULL SWEEP: Vivo si no ha tocado TP (h0 < mid) Y no ha roto su mínimo (l0 >= l1)
        if h0 < mid and l0 >= l1
            c_bias := "B.SWP"
            c_col := color.green
            t1 := mid
            t2 := h2
            label_t1 := "50% B.SWP " + tf_name
            label_t2 := "100% B.SWP " + tf_name
            
    else if h1 > h2 and c1 > h2 and l1 > l2
        // BULL RUN: Vivo si no ha tocado TP (h0 < ext_bull) Y no ha reingresado rompiendo el mínimo (l0 >= l2)
        if h0 < ext_bull and l0 >= l2
            c_bias := "B.RUN"
            c_col := color.lime
            t1 := h1
            t2 := ext_bull
            label_t1 := "Max.Ant B.RUN " + tf_name
            label_t2 := "161% B.RUN " + tf_name
            
    else if h1 > h2 and c1 < h2 and l1 > l2
        // BEAR SWEEP: Vivo si no ha tocado TP (l0 > mid) Y no ha roto su máximo (h0 <= h1)
        if l0 > mid and h0 <= h1
            c_bias := "S.SWP"
            c_col := color.red
            t1 := mid
            t2 := l2
            label_t1 := "50% S.SWP " + tf_name
            label_t2 := "100% S.SWP " + tf_name
            
    else if l1 < l2 and c1 < l2 and h1 < h2
        // BEAR RUN: Vivo si no ha tocado TP (l0 > ext_bear) Y no ha reingresado rompiendo el máximo (h0 <= h2)
        if l0 > ext_bear and h0 <= h2
            c_bias := "S.RUN"
            c_col := color.maroon
            t1 := l1
            t2 := ext_bear
            label_t1 := "Min.Ant S.RUN " + tf_name
            label_t2 := "161% S.RUN " + tf_name

    // 2. POTENCIAL (Vela en formación)
    if l0 < l1 and c0 > l1
        pot := "B.SWP"
        p_col := color.new(color.green, 50)
    else if h0 > h1 and c0 < h1
        pot := "S.SWP"
        p_col := color.new(color.red, 50)
    else if h0 > h1 and c0 > h1
        pot := "B.RUN"
        p_col := color.new(color.lime, 50)
    else if l0 < l1 and c0 < l1
        pot := "S.RUN"
        p_col := color.new(color.maroon, 50)

    [c_bias, c_col, pot, p_col, t1, t2, label_t1, label_t2]

// --- ARRAYS GLOBALES PARA AGRUPACIÓN DE NIVELES ---
var t_prices = array.new_float()
var t_labels = array.new_string()
var t_colors = array.new_color()
var t_prev_lines = array.new_line()
var t_prev_labels = array.new_label()

// --- FUNCIÓN DE AGRUPACIÓN ---
add_target(price, lbl, col) =>
    if not na(price)
        tolerance = syminfo.mintick * merge_ticks
        found = false
        sz = array.size(t_prices)
        if sz > 0
            for i = 0 to sz - 1
                if math.abs(array.get(t_prices, i) - price) <= tolerance
                    array.set(t_labels, i, array.get(t_labels, i) + " + " + lbl)
                    found := true
                    break
        if not found
            array.push(t_prices, price)
            array.push(t_labels, lbl)
            array.push(t_colors, col)

// --- PROCESAMIENTO MULTI-TIMEFRAME ---
[mn_b, mn_bc, mn_p, mn_pc, mn_t1, mn_t2, mn_l1, mn_l2] = get_crt_info("1M")
[w1_b, w1_bc, w1_p, w1_pc, w1_t1, w1_t2, w1_l1, w1_l2] = get_crt_info("1W")
[d1_b, d1_bc, d1_p, d1_pc, d1_t1, d1_t2, d1_l1, d1_l2] = get_crt_info("1D")
[h12_b, h12_bc, h12_p, h12_pc, h12_t1, h12_t2, h12_l1, h12_l2] = get_crt_info("720")
[h8_b, h8_bc, h8_p, h8_pc, h8_t1, h8_t2, h8_l1, h8_l2] = get_crt_info("480")
[h4_b, h4_bc, h4_p, h4_pc, h4_t1, h4_t2, h4_l1, h4_l2] = get_crt_info("240")

// --- DIBUJO DE NIVELES ---
if barstate.islast
    // borrar dibujos previos (líneas y etiquetas) para reemplazarlos
    if array.size(t_prev_lines) > 0
        for i = 0 to array.size(t_prev_lines) - 1
            line.delete(array.get(t_prev_lines, i))
    if array.size(t_prev_labels) > 0
        for i = 0 to array.size(t_prev_labels) - 1
            label.delete(array.get(t_prev_labels, i))
    array.clear(t_prev_lines)
    array.clear(t_prev_labels)

    array.clear(t_prices)
    array.clear(t_labels)
    array.clear(t_colors)

    add_target(mn_t1, mn_l1, mn_bc)
    add_target(mn_t2, mn_l2, mn_bc)
    add_target(w1_t1, w1_l1, w1_bc)
    add_target(w1_t2, w1_l2, w1_bc)
    add_target(d1_t1, d1_l1, d1_bc)
    add_target(d1_t2, d1_l2, d1_bc)
    add_target(h12_t1, h12_l1, h12_bc)
    add_target(h12_t2, h12_l2, h12_bc)
    add_target(h8_t1, h8_l1, h8_bc)
    add_target(h8_t2, h8_l2, h8_bc)
    add_target(h4_t1, h4_l1, h4_bc)
    add_target(h4_t2, h4_l2, h4_bc)

    sz_draw = array.size(t_prices)
    tolerance = syminfo.mintick * merge_ticks
    if sz_draw > 0
        for i = 0 to sz_draw - 1
            p = array.get(t_prices, i)
            // Si la mecha de la vela actual tocó el nivel dentro de la tolerancia, no dibujar (se interpreta como cumplido/eliminado)
            if not na(p) and (p >= low - tolerance and p <= high + tolerance)
                continue
            l = array.get(t_labels, i)
            c = array.get(t_colors, i)
            ln = line.new(bar_index, p, bar_index + 20, p, extend=extend.right, color=c, style=line.style_dashed, width=2)
            lb = label.new(bar_index + 15, p, l, style=label.style_label_down, color=c, textcolor=color.white, size=size.normal)
            array.push(t_prev_lines, ln)
            array.push(t_prev_labels, lb)

// --- TABLA DEL DASHBOARD ---
var table mainTable = table.new(position.top_right, 5, 7, border_width = 1, frame_color=color.gray)
if barstate.islast
    table.cell(mainTable, 0, 0, "TF", bgcolor=color.black, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, 0, "CONF.", bgcolor=color.black, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 2, 0, "POTENCIAL", bgcolor=color.black, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 3, 0, "BASE WR", bgcolor=color.black, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 4, 0, "SINERGIA", bgcolor=color.black, text_color=color.white, text_size=size.normal)
    
    TFs = array.from("MN1", "W1", "D1", "H12", "H8", "H4")
    Bias = array.from(mn_b, w1_b, d1_b, h12_b, h8_b, h4_b)
    BCol = array.from(mn_bc, w1_bc, d1_bc, h12_bc, h8_bc, h4_bc)
    Pats = array.from(mn_p, w1_p, d1_p, h12_p, h8_p, h4_p)
    PCol = array.from(mn_pc, w1_pc, d1_pc, h12_pc, h8_pc, h4_pc)
    
    dir_mn1 = get_dir(mn_b)
    dir_w1  = get_dir(w1_b)
    dir_d1  = get_dir(d1_b)

    for i = 0 to 5
        table.cell(mainTable, 0, i+1, array.get(TFs, i), bgcolor=color.new(color.gray, 85), text_size=size.normal)
        table.cell(mainTable, 1, i+1, array.get(Bias, i), bgcolor=array.get(BCol, i), text_color=color.white, text_size=size.normal)
        table.cell(mainTable, 2, i+1, array.get(Pats, i), bgcolor=array.get(PCol, i), text_color=color.white, text_size=size.normal)
        
        float base_wr = get_stats(syminfo.tickerid, array.get(TFs, i), array.get(Bias, i))
        table.cell(mainTable, 3, i+1, base_wr > 0 ? str.tostring(base_wr) + "%" : "-", bgcolor=color.new(color.gray, 85), text_size=size.normal)

        string syn_txt = "-"
        color syn_col = color.new(color.gray, 85)
        
        if i >= 3
            string cur_dir = get_dir(array.get(Bias, i))
            if cur_dir != "NEUTRO"
                int align_count = 0
                int opp_count = 0
                
                if dir_d1 == cur_dir
                    align_count += 1
                else if dir_d1 != "NEUTRO"
                    opp_count += 1
                
                if dir_w1 == cur_dir
                    align_count += 1
                else if dir_w1 != "NEUTRO"
                    opp_count += 1
                
                if dir_mn1 == cur_dir
                    align_count += 1
                else if dir_mn1 != "NEUTRO"
                    opp_count += 1

                if align_count == 3
                    syn_txt := "🔥 +3 HTF"
                    syn_col := color.new(color.lime, 70)
                else if align_count == 2
                    syn_txt := "⚡ +2 HTF"
                    syn_col := color.new(color.green, 70)
                else if align_count == 1 and opp_count == 0
                    syn_txt := "✅ +1 HTF"
                    syn_col := color.new(color.teal, 70)
                else if opp_count >= 2
                    syn_txt := "⚠️ CONTRA"
                    syn_col := color.new(color.red, 70)
                else if opp_count == 1
                    syn_txt := "➖ MIXTO"
                    syn_col := color.new(color.orange, 70)

        table.cell(mainTable, 4, i+1, syn_txt, bgcolor=syn_col, text_color=color.white, text_size=size.normal)
